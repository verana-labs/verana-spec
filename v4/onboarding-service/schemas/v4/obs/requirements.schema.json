{
  "$id": "https://verana-labs.github.io/verana-spec/v4/onboarding-service/schemas/v4/obs/requirements.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ecosystem Onboarding Service requirements file",
  "description": "Evidence an applicant must provide for a round of an Onboarding Process, beyond the credential claims: documents to upload, additional fields to fill, per-schema links for missing prerequisite credentials, and instructions. See [OBS-CFG-REQ] of the Ecosystem Onboarding Service v4 Specification.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "documents": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/DocumentRequirement" }
    },
    "fields": {
      "type": "array",
      "default": [],
      "items": { "$ref": "#/$defs/FieldRequirement" }
    },
    "credentialLinks": {
      "type": "object",
      "description": "Maps a CredentialSchema.id (as a decimal string) to the URL shown to an applicant that lacks a credential of that schema. Overrides the default link of [OBS-APP-ELIG-4].",
      "propertyNames": { "pattern": "^[0-9]+$" },
      "additionalProperties": { "type": "string", "format": "uri", "pattern": "^https://" }
    },
    "instructions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "applicant": { "$ref": "#/$defs/LocalizedText", "description": "Markdown shown at the top of the applicant evidence step." },
        "validator": { "$ref": "#/$defs/LocalizedText", "description": "Markdown shown at the top of the validator review." }
      }
    }
  },
  "$defs": {
    "LocalizedText": {
      "description": "A string, or an object keyed by BCP 47 language tag.",
      "oneOf": [
        { "type": "string", "maxLength": 16384 },
        {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]{2,8})*$" },
          "additionalProperties": { "type": "string", "maxLength": 16384 }
        }
      ]
    },
    "Identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "DocumentRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "mediaTypes", "maxSizeBytes"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier", "description": "Unique among documents." },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "description": { "$ref": "#/$defs/LocalizedText" },
        "mediaTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z]+/[A-Za-z0-9!#$&^_.+-]+$" },
          "description": "Accepted IANA media types, verified from the uploaded content."
        },
        "maxSizeBytes": { "type": "integer", "minimum": 1, "maximum": 1073741824 },
        "required": { "type": "boolean", "default": true },
        "multiple": { "type": "boolean", "default": false, "description": "Whether several files may be uploaded for this requirement." }
      }
    },
    "FieldRequirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "type"],
      "properties": {
        "id": { "$ref": "#/$defs/Identifier", "description": "Unique among fields." },
        "label": { "$ref": "#/$defs/LocalizedText" },
        "description": { "$ref": "#/$defs/LocalizedText" },
        "type": { "type": "string", "enum": ["text", "textarea", "number", "date", "url", "select"] },
        "required": { "type": "boolean", "default": true },
        "options": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["value", "label"],
            "properties": {
              "value": { "type": "string", "maxLength": 256 },
              "label": { "$ref": "#/$defs/LocalizedText" }
            }
          },
          "description": "Required when type is select; ignored otherwise."
        },
        "pattern": { "type": "string", "format": "regex", "description": "Applies to text, textarea and url values." },
        "maxLength": { "type": "integer", "minimum": 1, "maximum": 16384 }
      },
      "if": { "properties": { "type": { "const": "select" } } },
      "then": { "required": ["options"] }
    }
  }
}
